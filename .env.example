# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
#
# These credentials are a PUBLIC PLACEHOLDER, published in this repository.
# They are fine for local development because POSTGRES_BIND keeps the port on
# loopback. Widen the bind and the stack will refuse to start until you set a
# real password.
POSTGRES_USER=openfutve
POSTGRES_PASSWORD=openfutve
POSTGRES_DB=openfutve

# Bind address for the published port. 127.0.0.1 = this machine only.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgres://openfutve:openfutve@localhost:5432/openfutve?sslmode=disable

# --- API ---
API_PORT=3000

# --- Web ---
#
# apps/web reaches apps/api over HTTP and never touches Postgres (ADR 0006), so
# this is the only wiring it needs. In compose it points at the api service.
OPENFUTVE_API_URL=http://localhost:3000
# Server rendering blocks on API calls, so a slow API degrades the page instead
# of holding the response open.
OPENFUTVE_API_TIMEOUT_MS=5000

# --- Pollers ---
# Identify the bot on every outbound request. Do not remove.
POLLER_USER_AGENT=openfutve-bot/0.1 (+https://github.com/openfutve/openfutve)
POLLER_LOG_LEVEL=info

# TheSportsDB. "123" is the public test key; audited as unusable — see
# docs/data-sources.md. Kept only so the audit trail has somewhere to point.
THESPORTSDB_API_KEY=123
THESPORTSDB_LEAGUE_ID=4513

# APIfootball.com (NOT api-football.com — different company, see docs/data-sources.md).
# This IS a secret. Put the real value in .env, never here, never in a commit.
#
# Their terms state accounts are individual and must not be shared between
# developers: get your own key at https://apifootball.com rather than reusing
# someone else's. That applies to self-hosters too.
APIFOOTBALL_API_KEY=
APIFOOTBALL_LEAGUE_ID=337
